# Copier ce fichier en .env puis remplir les valeurs.

# Port d'écoute de l'API (et du site)
PORT=8080

# Jeton de l'espace admin (/admin). Générer une valeur longue, par ex. :
#   openssl rand -hex 32
ADMIN_TOKEN=

# Adresse qui reçoit les messages et les commandes
MAIL_TO=mstechniker96@gmail.com

# Envoi d'e-mails (Gmail : activer la validation en 2 étapes puis créer un
# « mot de passe d'application » sur https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mstechniker96@gmail.com
SMTP_PASS=
# Envoyer un e-mail de confirmation au client après une commande (true/false)
CONFIRMATION_CLIENT=true

# Origines autorisées à appeler l'API depuis un autre domaine (ex. GitHub Pages),
# séparées par des virgules. Vide si le site et l'API sont sur le même serveur.
CORS_ORIGINS=https://sidis17.github.io

# true si l'API est derrière un proxy (Nginx, Caddy) qui fixe X-Forwarded-For
TRUST_PROXY=true
